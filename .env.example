# ─────────────────────────────────────────────────���───────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth V2 migration flag — see docs/ARCHITECTURE.md "High risk: Auth V2 migration"
# NEXT_PUBLIC_AUTH_V2=true

# HMAC secret signing interview session tokens — generate with: openssl rand -hex 32
SESSION_SIGNING_SECRET=your_session_signing_secret

# ───────────────────────────────────────────────────────────��─────────────────
# OpenAI — Primary AI provider (question generation, resume parsing, evaluation)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter — Used for free public tools (ATS checker, question generator,
# star builder). Falls back to OPENAI_API_KEY if not set.
# Get from: https://openrouter.ai/keys
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: override default models per free tool
# OPENROUTER_ATS_MODEL=openai/gpt-4o-mini
# OPENROUTER_QUESTIONS_MODEL=openai/gpt-4o-mini
# OPENROUTER_STAR_MODEL=openai/gpt-4o-mini

# Optional: branding headers sent to OpenRouter
# OPENROUTER_HTTP_REFERER=https://interviewera.com
# OPENROUTER_APP_TITLE=InterviewEra

# ────────────────────────────────���────────────────────────────────────────────
# Mistral AI — the client code (src/lib/mistral/) was deleted 2026-07-05 (zero
# importers); only a startup check reads this var (to warn if it's missing). Do
# not assume this activates a fallback on OpenAI quota exhaustion — see CLAUDE.md
# Critical Invariant #9.
# Get from: https://console.mistral.ai → API Keys
# ─────────────────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key

# When true: OpenRouter-only completions, Mistral/direct-OpenAI fallback disabled.
# See CLAUDE.md Critical Invariant #9 before assuming automatic failover.
# SINGLE_PROVIDER_MODE=true

# Optional: override default OpenRouter models used by core interview/resume ops
# OPENROUTER_CHEAP_MODEL=openai/gpt-4.1-mini
# OPENROUTER_SMART_MODEL=openai/gpt-4.1
# OPENROUTER_QUESTION_GEN_MODEL=google/gemini-2.5-flash
# RESUME_PARSE_MODEL=openai/gpt-4.1-mini
# OPENAI_ATS_MODEL=openai/gpt-4o-mini

# Optional: resume extraction tuning
# RESUME_OCR_ENABLED=true
# RESUME_PARSE_FORCE_AI=false

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay — One-time monthly payments (Orders API)
# ─────────────────────────────────────────────────────────────────────────────
# Amounts are defined in code (src/lib/pricing/plans.ts) — no Razorpay plan IDs.
# Webhook URL: https://interviewera.com/api/payments/webhook
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─────────────────────────────────────────────────────────────────────────────
# Resend — Transactional email (weekly digest, campus invites)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
# Transactional lifecycle + password reset sender (Resend-verified domain)
SENDER_EMAIL_TRANSACTIONAL=InterviewEra <transactional@interviewera.com>
SENDER_EMAIL_REPLY_TO=support@interviewera.com
# One-time product update campaign (npm run send-product-update)
PRODUCT_UPDATE_APP_URL=https://interviewera.com
PRODUCT_UPDATE_FROM=Rakesh Kumar, Founder, InterviewEra <founder@interviewera.com>
PRODUCT_UPDATE_REPLY_TO=founder@interviewera.com
PRODUCT_UPDATE_SUBJECT=InterviewEra just got better — your account has been updated
# HMAC secret for unsubscribe tokens — generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=your_unsubscribe_secret
# Inbox that receives in-app feedback submissions (POST /api/feedback)
FOUNDER_FEEDBACK_EMAIL=Rakesh.kr2604@gmail.com

# Alternate email provider — defaults to 'resend' if unset. One of: resend | postmark | ses | smtp.
# EMAIL_PROVIDER=resend
# Sender address read by the queued-email providers above (postmark/resend/ses/smtp)
# EMAIL_FROM=InterviewEra <noreply@interviewera.com>
# Sender address used by the direct-send path (src/lib/email/send.ts)
# SENDER_EMAIL_NO_REPLY=InterviewEra <no-reply@interviewera.com>
# HMAC secret for email-queue job signing — generate with: openssl rand -hex 32
# EMAIL_SIGNING_SECRET=your_email_signing_secret
# Base URL used for constructing email links when NEXT_PUBLIC_APP_URL is not applicable
# NEXT_PUBLIC_API_URL=https://api.interviewera.com
# — Postmark (EMAIL_PROVIDER=postmark)
# POSTMARK_SERVER_TOKEN=your_postmark_server_token
# — AWS SES (EMAIL_PROVIDER=ses)
# AWS_REGION=ap-south-1
# — SMTP (EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587

# ─────────────────────────────────────────────────────────────────────────────
# ElevenLabs — Avatar TTS via /api/tts (server-only; never NEXT_PUBLIC_)
# Priya → Sia (W7iR5kTNHozpIl2Jqq15) | Arjun → Sagar (Qc0h5B5Mqs8oaH4sFZ9X)
# Legacy env names ELEVENLABS_VOICE_ID_FEMALE / _MALE are also read if set.
# ─────────────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_PRIYA_ID=W7iR5kTNHozpIl2Jqq15
ELEVENLABS_VOICE_ARJUN_ID=Qc0h5B5Mqs8oaH4sFZ9X
# Defaults to eleven_flash_v2_5 (low latency, streaming) if unset.
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Deepgram — Streaming STT (Nova-3) via /api/stt/token
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_PROJECT_ID=your_deepgram_project_id

# ───────────────────────────────────────────��─────────────────────────────────
# Cron
# Set the same value in Vercel project settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET=your_cron_secret

# Platform admin — comma-separated founder emails (also accepts users.platform_role = admin)
ADMIN_EMAILS=founder@interviewera.com

# Campus org auto-approve — keep UNSET in production
# CAMPUS_ORG_APPROVED_EMAILS=pilot@college.edu
# CAMPUS_WORKSPACE_AUTO_APPROVE=false

# Optional A/B override for first-interview question count
# NEXT_PUBLIC_FIRST_INTERVIEW_QUESTIONS=6

# Debug routes — keep 0 or unset in production
# IE_DEBUG_ROUTES=0
# IE_UPLOAD_DIAGNOSTICS=0
# IE_UPLOAD_BYPASS_PARSE=0
# IE_UPLOAD_SKIP_DB=0

# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis — Rate limiting + question generation cache
# Used by: /api/interview/answer, /api/interview/start, /api/resume/upload,
#          /api/payments/create-order, and question cache layer
# Get from: https://console.upstash.com → Create Database → REST API
# ───────────────────────────────────────────���─────────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ─────────────────────────────────────────────────────────────────────────────
# App
# ────────────────────────────────────────────────────���────────────────────────
# Development: http://localhost:3000  |  Production: https://interviewera.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Calendly — campus page demo booking
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/demo

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Clarity — session recording + heatmaps
# Script is disabled in development (NODE_ENV !== "production").
# Get from: https://clarity.microsoft.com → Settings → Overview → Project ID
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLARITY_ID=your_clarity_project_id

# ─────────────────────────────────────────────────────────────────────────────
# Google Analytics 4 — page views + custom events (gtag.js)
# Script is disabled in development (NODE_ENV !== "production").
# Get from: https://analytics.google.com → Admin → Data Streams → Measurement ID
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-S0W24B29KG

# Canonical HTTPS origin for SEO surfaces (sitemap, robots, JSON-LD). Falls back
# to NEXT_PUBLIC_APP_URL, then a hardcoded production origin; both are ignored
# when they point at localhost so a local .env never pollutes production XML.
# NEXT_PUBLIC_SITE_URL=https://interviewera.com

# Force noindex/nofollow on the entire site regardless of route — non-production
# Vercel environments (preview/dev) are already blocked by default. Keep unset in production.
# BLOCK_SEARCH_INDEXING=false

# IndexNow — Bing/Yandex instant indexing (see docs/SEO.md)
# INDEXNOW_KEY=your_indexnow_key
# INDEXNOW_SUBMIT_SECRET=your_indexnow_submit_secret
# INDEXNOW_DEBUG=0

# Bundle analyzer — `npm run analyze` sets this automatically
# ANALYZE=false

# ─────────────────────────────────────────────────────────────────────────────
# Manual verification scripts (scripts/*.mjs, *.ts) — all optional, all have
# safe inline defaults. Only needed if running these scripts directly.
# ─────────────────────────────────────────────────────────────────────────────
# APP_URL, BASE_URL, INTERVIEW_SESSION_URL, INTERVIEW_SESSION_ID, VERIFY_USER_EMAIL,
# RUNTIME_VALIDATION_BASE_URL, CHROME_CHANNEL, HEADED, VERBOSE

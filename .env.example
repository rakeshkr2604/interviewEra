# ─────────────────────────────────────────────────���───────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ───────────────────────────────────────────────────────────��─────────────────
# OpenAI — Primary AI provider (question generation, resume parsing, evaluation)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter — Used for free public tools (ATS checker, question generator,
# star builder). Falls back to OPENAI_API_KEY if not set.
# Get from: https://openrouter.ai/keys
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: override default models per free tool
# OPENROUTER_ATS_MODEL=openai/gpt-4o-mini
# OPENROUTER_QUESTIONS_MODEL=openai/gpt-4o-mini
# OPENROUTER_STAR_MODEL=openai/gpt-4o-mini

# Optional: branding headers sent to OpenRouter
# OPENROUTER_HTTP_REFERER=https://interviewera.com
# OPENROUTER_APP_TITLE=InterviewEra

# ────────────────────────────────���────────────────────────────────────────────
# Mistral AI — Fallback for core AI routes when OpenAI quota is exhausted
# Activates automatically on QuotaExhaustedError — no manual switch needed.
# Get from: https://console.mistral.ai → API Keys
# ─────────────────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay — Payments (UPI + card + netbanking)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Create these plans in Razorpay Dashboard → Plans, then paste the plan IDs here
# Monthly plans (period=monthly, interval=1)
RAZORPAY_STARTER_PLAN_ID=plan_xxxx
RAZORPAY_PRO_PLAN_ID=plan_xxxx
# Annual plans (period=yearly, interval=1)
RAZORPAY_STARTER_ANNUAL_PLAN_ID=plan_xxxx
RAZORPAY_PRO_ANNUAL_PLAN_ID=plan_xxxx

# ─────────────────────────────────────────────────────────────────────────────
# Resend — Transactional email (weekly digest, campus invites)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
# HMAC secret for unsubscribe tokens — generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=your_unsubscribe_secret
# Inbox that receives in-app feedback submissions (POST /api/feedback)
FOUNDER_FEEDBACK_EMAIL=Rakesh.kr2604@gmail.com

# ───────────────────────────────────────────��─────────────────────────────────
# Cron
# Set the same value in Vercel project settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET=your_cron_secret

# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis — Rate limiting + question generation cache
# Used by: /api/interview/answer, /api/interview/start, /api/resume/upload,
#          /api/payments/create-order, and question cache layer
# Get from: https://console.upstash.com → Create Database → REST API
# ───────────────────────────────────────────���─────────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ─────────────────────────────────────────────────────────────────────────────
# App
# ────────────────────────────────────────────────────���────────────────────────
# Development: http://localhost:3000  |  Production: https://interviewera.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Calendly — campus page demo booking
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/demo

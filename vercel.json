{
  "installCommand": "npm install --no-fund --no-audit --loglevel=error --include=dev",
  "crons": [
    {
      "path": "/api/cron/health-snapshot",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/daily-rollup",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    }
  ],
  "functions": {
    "src/app/api/resume/upload/route.ts": { "maxDuration": 60 },
    "src/app/api/resume/parse/route.ts": { "maxDuration": 60 },
    "src/app/api/job-description/extract/route.ts": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.interviewera.com"
        }
      ],
      "destination": "https://interviewera.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        },
        {
          "type": "host",
          "value": "interviewera.com"
        }
      ],
      "destination": "https://interviewera.com/:path*",
      "permanent": true
    }
  ]
}

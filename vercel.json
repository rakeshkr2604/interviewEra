{
  "functions": {
    "src/app/api/resume/upload/route.ts": { "maxDuration": 60 },
    "src/app/api/resume/parse/route.ts": { "maxDuration": 60 },
    "src/app/api/job-description/extract/route.ts": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.interviewera.com"
        }
      ],
      "destination": "https://interviewera.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        },
        {
          "type": "host",
          "value": "interviewera.com"
        }
      ],
      "destination": "https://interviewera.com/:path*",
      "permanent": true
    }
  ]
}

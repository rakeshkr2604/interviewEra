{
  "functions": {
    "src/app/api/resume/upload/route.ts": { "maxDuration": 30 },
    "src/app/api/resume/parse/route.ts":  { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.interviewera.com"
        }
      ],
      "destination": "https://interviewera.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://interviewera.com/:path*",
      "permanent": true
    }
  ]
}

{
  "name": "interviewera",
  "version": "0.1.0",
  "description": "Node 20.x (Vercel). pdfjs-dist@5.4.296 + pdf-parse@1.1.1; see dependencies.",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev --turbopack",
    "dev:fresh": "npm run clean && next dev --webpack",
    "dev:fresh:turbo": "npm run clean && next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "build:turbo": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pdf": "tsx scripts/verify-pdf-extract.ts",
    "generate:pdf-fixtures": "tsx scripts/generate-pdf-fixtures.tsx",
    "generate:favicon-ico": "node scripts/generate-favicon-ico.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@napi-rs/canvas": "0.1.80",
    "@next/bundle-analyzer": "^16.2.2",
    "@react-pdf/renderer": "^4.3.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.101.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^3.12.0",
    "lucide-react": "^0.552.0",
    "motion": "^12.38.0",
    "next": "^16.2.4",
    "openai": "^6.38.0",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "5.7.284",
    "razorpay": "^2.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.8.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2",
    "shadcn": "^4.6.0",
    "supabase": "^2.98.2",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "uuid": "^11.0.0",
    "node-domexception": "2.0.2",
    "@napi-rs/canvas": "0.1.80",
    "jsdom": "24.1.3"
  }
}

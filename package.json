{
  "name": "interviewera",
  "version": "1.0.0",
  "description": "Node 22.x (Vercel). pdfjs-dist@5.7.284 + pdf-parse@1.1.1; see dependencies.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev --webpack -H 0.0.0.0",
    "dev:turbopack": "next dev --turbopack -H 0.0.0.0",
    "dev:fresh": "npm run clean && next dev --webpack -H 0.0.0.0",
    "dev:fresh:turbo": "npm run clean && next dev --turbopack -H 0.0.0.0",
    "dev:webpack": "next dev --webpack -H 0.0.0.0",
    "build": "next build --webpack && tsx scripts/noindex-audit.ts",
    "audit:noindex": "tsx scripts/noindex-audit.ts",
    "build:turbo": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @integration",
    "test:e2e:integration": "playwright test --grep @integration",
    "test:e2e:ui": "playwright test --ui",
    "verify:pdf": "tsx scripts/verify-pdf-extract.ts",
    "submit:indexnow": "tsx scripts/submit-indexnow.ts",
    "generate:pdf-fixtures": "tsx scripts/generate-pdf-fixtures.tsx",
    "generate:favicon-ico": "node scripts/generate-favicon-ico.mjs",
    "verify:voice": "node scripts/voice-fix-verify.mjs",
    "email": "email dev --dir src/emails",
    "send-product-update": "tsx scripts/send-product-update.ts",
    "send-product-update:dry-run": "tsx scripts/send-product-update.ts --dry-run",
    "send-product-update:preview": "tsx scripts/send-product-update.ts --preview",
    "send-product-update:retry": "tsx scripts/send-product-update.ts --retry-failed",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@deepgram/sdk": "^5.2.0",
    "@napi-rs/canvas": "0.1.80",
    "@next/bundle-analyzer": "^16.2.6",
    "@react-email/render": "^2.0.9",
    "@react-pdf/renderer": "^4.3.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.101.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^3.12.0",
    "lucide-react": "^0.552.0",
    "mammoth": "^1.12.0",
    "motion": "^12.38.0",
    "next": "^16.2.7",
    "openai": "^6.38.0",
    "pdf-parse": "1.1.1",
    "pdfjs-dist": "5.7.284",
    "razorpay": "^2.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.16",
    "tesseract.js": "^5.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.56.1",
    "@react-email/ui": "^6.6.3",
    "@types/node": "^26.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2",
    "react-email": "^6.6.3",
    "shadcn": "^4.6.0",
    "supabase": "^2.98.2",
    "tsx": "^4.20.6",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "uuid": "^11.0.0",
    "node-domexception": "2.0.2",
    "@napi-rs/canvas": "0.1.80",
    "jsdom": "24.1.3",
    "postcss": "^8.5.10"
  }
}
